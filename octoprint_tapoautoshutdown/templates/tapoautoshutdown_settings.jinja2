<div class="control-group">
    <label class="control-label">OctoPi Tapo P110 IP address</label>
    <div class="controls">
        <input type="text"
            class="input-block-level"
            data-bind="value: settings.plugins.tapoautoshutdown.octopi_tapo_ip">
    </div>
</div>

<div class="control-group">
    <label class="control-label">OctoPi Tapo username</label>
    <div class="controls">
        <input type="text"
            class="input-block-level"
            data-bind="value: settings.plugins.tapoautoshutdown.octopi_tapo_username">
    </div>
</div>

<div class="control-group">
    <label class="control-label">OctoPi Tapo password</label>
    <div class="controls">
        <input type="password"
            class="input-block-level"
            data-bind="value: settings.plugins.tapoautoshutdown.octopi_tapo_password">
    </div>
</div>

<div class="control-group">
    <label class="control-label">Printer Tapo P110 IP address</label>
    <div class="controls">
        <input type="text"
            class="input-block-level"
            data-bind="value: settings.plugins.tapoautoshutdown.ip">
    </div>
</div>

<div class="control-group">
    <label class="control-label">Printer Tapo username</label>
    <div class="controls">
        <input type="text"
            class="input-block-level"
            data-bind="value: settings.plugins.tapoautoshutdown.username">
    </div>
</div>

<div class="control-group">
    <label class="control-label">Printer Tapo password</label>
    <div class="controls">
        <input type="password"
            class="input-block-level"
            data-bind="value: settings.plugins.tapoautoshutdown.password">
    </div>
</div>



<div class="control-group">
    <label class="control-label">Printer shutdown delay (minutes)</label>
    <div class="controls">
        <input type="number"
            class="input-block-level"
            data-bind="value: settings.plugins.tapoautoshutdown.tapo_shutdown_delay">
        	<p class="help-block">
            	Time to wait after a completed print before switching the Printer P110 off.
        	</p>
    </div>
</div>

<div class="control-group">
    <label class="control-label">OctoPi Tapo P110</label>
    <div class="controls">
        <label class="checkbox">
            <input type="checkbox"
                data-bind="checked: settings.plugins.tapoautoshutdown.octopi_tapo_enabled">
            Enable OctoPi Tapo P110
        </label>
        <p class="help-block">
            Enable control of a second Tapo P110 that powers the Raspberry Pi running OctoPrint.
        </p>
    </div>
</div>

<div class="control-group">
    <label class="control-label">Shut down OctoPi</label>
    <div class="controls">
        <label class="checkbox">
            <input type="checkbox"
                data-bind="checked: settings.plugins.tapoautoshutdown.octopi_shutdown_enabled">
            Shut down OctoPi after successful timelapse rendering
        </label>
        <p class="help-block">
            After a successful print and completed timelapse rendering, safely shut down OctoPi before switching off the OctoPi Tapo P110.
        </p>
    </div>
</div>


<div class="control-group">
    <label class="control-label">Obico AI delay (minutes)</label>
    <div class="controls">
        <input type="number"
            class="input-block-level"
            min="0"
            data-bind="value: settings.plugins.tapoautoshutdown.obico_monitor_delay">
        <p class="help-block">
            Time to wait after a print starts before enabling Obico AI failure detection.
            Set to 0 to enable AI immediately.
        </p>
    </div>
</div>

