<div class="row-fluid">
    <div class="span6">
        <div class="control-group">
            <label class="control-label">Tapo account username</label>
            <div class="controls">
                <input type="text"
                    class="input-medium"
                    data-bind="value: settings.plugins.tapoautoshutdown.username">
            </div>
        </div>
    </div>
    <div class="span6">
        <div class="control-group">
            <label class="control-label">Tapo account password</label>
            <div class="controls">
                <input type="password"
                    class="input-medium"
                    data-bind="value: settings.plugins.tapoautoshutdown.password">
            </div>
        </div>
    </div>
</div>

<div class="control-group">
    <label class="control-label">OctoPi Tapo P110 IP address</label>
    <div class="controls">
        <span class="ip-prefix">192.168.1.</span>
        <input type="number" class="input-mini" min="1" max="254" step="1" inputmode="numeric"
            placeholder="1–254"
            aria-label="OctoPi Tapo IP final octet"
            data-bind="value: settings.plugins.tapoautoshutdown.octopi_tapo_ip_last_octet">
        <p class="help-block">Enter a number from 1 to 254.</p>
    </div>
</div>

<div class="control-group">
    <label class="control-label">Printer Tapo P110 IP address</label>
    <div class="controls">
        <span class="ip-prefix">192.168.1.</span>
        <input type="number" class="input-mini" min="1" max="254" step="1" inputmode="numeric"
            placeholder="1–254"
            aria-label="Printer Tapo IP final octet"
            data-bind="value: settings.plugins.tapoautoshutdown.printer_tapo_ip_last_octet">
        <p class="help-block">Enter a number from 1 to 254.</p>
    </div>
</div>

<div class="control-group">
    <label class="control-label">Automatic bed preheat</label>
    <div class="controls">
        <label class="checkbox">
            <input type="checkbox"
                   data-bind="checked: settings.plugins.tapoautoshutdown.bed_preheat_enabled">
            Enable automatic bed preheat
        </label>
        <p class="help-block">
            Automatically heat the bed to a fixed target of 50°C after
            the printer Tapo is on and OctoPrint has connected successfully.
        </p>
    </div>
</div>



<div class="control-group">
    <label class="control-label">OctoPi automatic shutdown</label>
    <div class="controls">
        <label class="checkbox">
            <input type="checkbox"
                data-bind="checked: settings.plugins.tapoautoshutdown.octopi_shutdown_enabled">
            Enable automatic OctoPi shutdown
        </label>
        <p class="help-block">
            When enabled, the OctoPi Tapo shutdown timer starts when the Ender Tapo plug has switched off after the bed cools to 30°C. OctoPrint is then asked to shut down cleanly. If a shutdown failure is detected it will attempt to cancel the timer.
        </p>
    </div>
</div>

<div class="control-group">
    <label class="control-label">OctoPi shutdown delay (minutes)</label>
    <div class="controls">
        <input type="number"
            class="input-medium"
            min="1"
            max="60"
            step="1"
            data-bind="value: settings.plugins.tapoautoshutdown.octopi_shutdown_delay">
       <p class="help-block">
            Time to allow the Raspberry Pi to complete its shutdown before the OctoPi Tapo P110 switches off. Recommended: 5 minutes. Allowed range: 1–60 minutes.
        </p> 
    </div>
</div>


<div class="control-group">
    <label class="control-label">Obico AI delay (minutes)</label>
    <div class="controls">
        <input type="number"
            class="input-medium"
            min="0"
            data-bind="value: settings.plugins.tapoautoshutdown.obico_monitor_delay">
        <p class="help-block">
            Time to wait after a print starts before enabling Obico AI failure detection.
            Set to 0 to enable AI immediately.
        </p>
    </div>
</div>

<div class="control-group">
    <label class="control-label">Notifications (ntfy.sh)</label>
    <div class="controls">
        <input type="text"
            class="input-xlarge"
            data-bind="value: settings.plugins.tapoautoshutdown.ntfy_topic"
            placeholder="Enter your ntfy topic">
        <p class="help-block">
            Topic used for phone push notifications at ntfy.sh. Use a hard-to-guess topic name and keep it private. Leave empty to disable ntfy notifications.
        </p>
    </div>
</div>



